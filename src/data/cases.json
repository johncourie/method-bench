  "variants": [
   {
    "id": "clean",
    "label": "Lot as labelled. Nothing unusual."
   },
   {
    "id": "interferent",
    "label": "A matrix compound co-elutes with EGCG under the starting gradient (5 to 40% B in 30 min at 1 mL/min) and moves away from it when the gradient slope changes. Because the overlap is exact there, a purity check across the peak does not flag it. What gives it away: the peak spectrum has a band near 325 nm that an EGCG standard lacks, its mass differs, and it separates from EGCG on a steeper or shallower gradient. Uncorrected, EGCG reads about 10% high.",
    "add": {
     "gtx": 70
    }
   },
   {
    "id": "heated",
    "label": "The extract was held hot in solution during manufacture (72 h at 60 °C): part of the EGCG has epimerized to GCG, and likewise for the other epimer pairs.",
    "stress": {
     "agent": "heat",
     "hours": 72,
     "tempC": 60
    }
   },
